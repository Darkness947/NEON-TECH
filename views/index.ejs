<!-- ============================================================
     views/index.ejs – Homepage
     ============================================================ -->

<!-- Hero -->
<section class="hero-section">
  <div class="container text-center">
    <p class="hero-subtitle">
      <%= lang === 'ar' ? 'مرحباً بك في' : 'WELCOME TO' %>
    </p>
    <h1 class="hero-title">⚡ NEON TECH</h1>
    <p style="color:var(--text-muted);font-size:1.05rem;max-width:520px;margin:0 auto 2rem;">
      <%= lang === 'ar'
        ? 'اكتشف أحدث الإلكترونيات بتصميم نيون فريد وأسعار لا تُضاهى'
        : 'Discover premium electronics. Engineered for the future, styled for the bold.' %>
    </p>
    <a href="#products" class="btn-neon btn me-2 btn-lg">
      <span><i class="bi bi-grid-3x3-gap me-2"></i><%= lang === 'ar' ? 'تسوق الآن' : 'Shop Now' %></span>
    </a>
    <% if (!user) { %>
    <a href="/auth/register" class="btn btn-outline-light btn-lg ms-2">
      <span><%= lang === 'ar' ? 'إنشاء حساب' : 'Create Account' %></span>
    </a>
    <% } %>
  </div>
</section>

<!-- Category Filter Bar -->
<section id="products" class="container mb-4">
  <div class="d-flex flex-wrap gap-2 align-items-center justify-content-center">
    <a href="/" class="category-pill <%= !selectedCategory ? 'active' : '' %>">
      <i class="bi bi-grid-fill me-1"></i>
      <%= lang === 'ar' ? 'الكل' : 'All' %>
    </a>
    <% categories.forEach(cat => { %>
      <a href="/?category=<%= encodeURIComponent(cat) %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"
         class="category-pill <%= selectedCategory === cat ? 'active' : '' %>">
        <%= {
          'Laptops & Computers':   lang === 'ar' ? '💻 لابتوبات وكمبيوترات' : '💻 Laptops & Computers',
          'Smartphones & Tablets': lang === 'ar' ? '📱 هواتف وتابلت'        : '📱 Smartphones & Tablets',
          'Gaming & Peripherals':  lang === 'ar' ? '🎮 ألعاب وإكسسوارات'    : '🎮 Gaming & Peripherals',
          'Audio & Wearables':     lang === 'ar' ? '🎧 صوتيات وأجهزة ذكية' : '🎧 Audio & Wearables'
        }[cat] || cat %>
      </a>
    <% }) %>
  </div>
</section>

<!-- Search Result Hint -->
<% if (search) { %>
  <div class="container mb-3">
    <p style="color:var(--text-muted);font-size:0.9rem;">
      <i class="bi bi-search me-2"></i>
      <%= lang === 'ar'
        ? `نتائج البحث عن "${search}" – ${products.length} منتج`
        : `Results for "${search}" – ${products.length} product(s)` %>
      <a href="/" class="ms-2" style="color:var(--neon-pink);font-size:0.8rem;">✕ <%= lang === 'ar' ? 'مسح' : 'Clear' %></a>
    </p>
  </div>
<% } %>

<!-- Product Grid -->
<section class="container pb-5">
  <% if (products.length === 0) { %>
    <div class="text-center py-5">
      <i class="bi bi-search" style="font-size:3rem;color:var(--text-muted);"></i>
      <p class="mt-3" style="color:var(--text-muted);">
        <%= lang === 'ar' ? 'لا توجد منتجات مطابقة.' : 'No products found matching your search.' %>
      </p>
      <a href="/" class="btn-neon btn mt-2"><span><%= lang === 'ar' ? 'عرض الكل' : 'View All' %></span></a>
    </div>
  <% } else { %>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4">
      <% products.forEach(product => { %>
        <div class="col">
          <div class="product-card card border-0 h-100">

            <!-- Compare Checkbox -->
            <label class="compare-check-label" title="<%= lang === 'ar' ? 'حدد للمقارنة' : 'Select to compare' %>">
              <input type="checkbox" class="compare-check" data-product-id="<%= product.id %>"
                     data-product-name="<%= lang === 'ar' ? product.name_ar : product.name_en %>">
              <span class="compare-check-box">
                <i class="bi bi-check-lg"></i>
              </span>
            </label>

            <!-- Product Image -->
            <a href="/products/<%= product.id %>">
              <div class="overflow-hidden" style="height:220px;">
                <img src="<%= product.image_path %>"
                     alt="<%= lang === 'ar' ? product.name_ar : product.name_en %>"
                     class="card-img-top"
                     style="height:100%;object-fit:cover;"
                     loading="lazy">
              </div>
            </a>

            <div class="card-body d-flex flex-column">
              <p class="product-category">
                <%= product.category %>
              </p>
              <h5 class="product-title">
                <a href="/products/<%= product.id %>" style="color:inherit;text-decoration:none;">
                  <%= lang === 'ar' ? product.name_ar : product.name_en %>
                </a>
              </h5>
              <!-- Rating -->
              <div class="product-rating mb-2">
                <% const r = Math.round(product.rating); %>
                <% for(let i=1; i<=5; i++) { %>
                  <i class="bi bi-star<%= i<=r ? '-fill' : '' %>"></i>
                <% } %>
                <span style="color:var(--text-muted);font-size:0.8rem;margin-left:4px;">(<%= Number(product.rating).toFixed(1) %>)</span>
              </div>

              <div class="mt-auto">
                <div class="d-flex justify-content-between align-items-center mb-3">
                  <span class="product-price">$<%= Number(product.price).toFixed(2) %></span>
                  <% if (product.stock <= 5 && product.stock > 0) { %>
                    <span class="badge-out"><%= lang === 'ar' ? 'كمية قليلة' : 'Low Stock' %></span>
                  <% } else if (product.stock === 0) { %>
                    <span class="badge-out"><%= lang === 'ar' ? 'نفد المخزون' : 'Out of Stock' %></span>
                  <% } %>
                </div>

                <!-- Add to Cart Form -->
                <% if (product.stock > 0) { %>
                  <form action="/cart/add" method="POST" class="d-flex gap-2">
                    <input type="hidden" name="product_id" value="<%= product.id %>">
                    <input type="hidden" name="quantity"   value="1">
                    <a href="/products/<%= product.id %>" class="btn btn-sm btn-outline-secondary flex-shrink-0"
                       style="color:var(--text-muted);border-color:var(--border-neon);">
                      <i class="bi bi-eye"></i>
                    </a>
                    <button type="submit" class="btn-neon btn btn-sm w-100"
                      <% if (!user) { %>
                        onclick="event.preventDefault();window.location='/auth/login';"
                      <% } %>>
                      <span><i class="bi bi-bag-plus me-1"></i>
                        <%= lang === 'ar' ? 'أضف للسلة' : 'Add to Cart' %>
                      </span>
                    </button>
                  </form>
                <% } else { %>
                  <button class="btn-neon btn btn-sm w-100" disabled style="opacity:0.4;">
                    <span><%= lang === 'ar' ? 'غير متاح' : 'Unavailable' %></span>
                  </button>
                <% } %>
              </div>
            </div>

          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>

<!-- ── Floating Compare Bar ───────────────────────────────────── -->
<div id="compareBar">
  <div class="container d-flex align-items-center justify-content-between">
    <div class="d-flex align-items-center gap-3">
      <i class="bi bi-robot" style="font-size:1.4rem;color:var(--neon-green);"></i>
      <span id="compareBarText" style="font-family:var(--font-ui);font-weight:600;letter-spacing:1px;">
        <%= lang === 'ar' ? 'حدد منتجين للمقارنة' : 'Select 2 products to compare' %>
      </span>
    </div>
    <div class="d-flex align-items-center gap-3">
      <button id="compareClearBtn" class="btn btn-sm" style="color:var(--text-muted);border:1px solid var(--border-neon);border-radius:6px;padding:0.3rem 0.8rem;font-family:var(--font-ui);">
        <%= lang === 'ar' ? 'مسح' : 'Clear' %>
      </button>
      <button id="compareNowBtn" class="btn-neon-filled btn btn-sm" disabled
              style="padding:0.4rem 1.5rem;font-family:var(--font-ui);font-weight:700;letter-spacing:1px;">
        <i class="bi bi-robot me-1"></i> <%= lang === 'ar' ? 'قارن الآن' : 'Compare Now' %>
      </button>
    </div>
  </div>
</div>

<!-- ── AI Comparison Modal ────────────────────────────────────── -->
<div id="compareModal" class="compare-modal-overlay">
  <div class="compare-modal-content">
    <button id="compareModalClose" class="compare-modal-close" title="Close">
      <i class="bi bi-x-lg"></i>
    </button>
    <div class="text-center mb-4">
      <div class="d-inline-flex align-items-center gap-2"
           style="font-family:var(--font-display);font-size:1.3rem;letter-spacing:3px;color:var(--neon-green);text-transform:uppercase;">
        <i class="bi bi-robot" style="font-size:1.5rem;"></i>
        <%= lang === 'ar' ? 'مقارنة الذكاء الاصطناعي' : 'AI Product Comparison' %>
      </div>
    </div>

    <!-- Product Header Cards -->
    <div class="row g-3 mb-4">
      <div class="col-6">
        <div class="neon-panel text-center" style="padding:1rem;" id="compareP1Card">
          <p class="product-category mb-1" id="compareP1Cat"></p>
          <h5 style="font-family:var(--font-ui);font-weight:700;color:var(--text-primary);font-size:0.95rem;" id="compareP1Name"></h5>
          <span class="product-price" style="font-size:1.2rem;" id="compareP1Price"></span>
        </div>
      </div>
      <div class="col-6">
        <div class="neon-panel text-center" style="padding:1rem;" id="compareP2Card">
          <p class="product-category mb-1" id="compareP2Cat"></p>
          <h5 style="font-family:var(--font-ui);font-weight:700;color:var(--text-primary);font-size:0.95rem;" id="compareP2Name"></h5>
          <span class="product-price" style="font-size:1.2rem;" id="compareP2Price"></span>
        </div>
      </div>
    </div>

    <!-- AI Result -->
    <div class="neon-panel ai-result-scroll" style="border-color:var(--neon-green);background:rgba(0,255,136,0.04);">
      <div id="compareResultContent" style="color:var(--text-primary);line-height:1.8;font-size:0.92rem;"></div>
    </div>
  </div>
</div>

