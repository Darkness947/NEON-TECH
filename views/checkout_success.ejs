<!-- ============================================================
     views/checkout_success.ejs – Order Confirmed
     ============================================================ -->
<div class="container py-5">
  <div class="text-center mb-5">
    <div style="width:90px;height:90px;background:rgba(0,255,136,0.1);border-radius:50%;
                margin:0 auto 1.5rem;display:flex;align-items:center;justify-content:center;
                border:2px solid var(--neon-green);animation:neonPulse 2s infinite;">
      <i class="bi bi-check-lg" style="font-size:2.5rem;color:var(--neon-green);"></i>
    </div>
    <h1 class="section-title" style="color:var(--neon-green);">
      <%= lang === 'ar' ? 'تم الطلب بنجاح!' : 'Order Confirmed!' %>
    </h1>
    <p style="color:var(--text-muted);margin-top:0.5rem;">
      <%= lang === 'ar'
        ? `رقم طلبك: #${orderId} – شكراً لتسوقك في NEON TECH!`
        : `Order #${orderId} – Thank you for shopping with NEON TECH!` %>
    </p>
    <p style="color:var(--text-muted);font-size:0.88rem;">
      <%= lang === 'ar'
        ? 'تم إرسال بريد تأكيد إلى عنوانك الإلكتروني.'
        : 'A confirmation email has been sent to your inbox.' %>
    </p>
  </div>

  <!-- Order Items -->
  <div class="row justify-content-center">
    <div class="col-lg-6">
      <div class="neon-panel">
        <div class="neon-panel-header">
          <i class="bi bi-receipt me-2"></i>
          <%= lang === 'ar' ? 'تفاصيل الطلب' : 'Order Summary' %>
        </div>
        <% items.forEach(item => { %>
          <div class="d-flex justify-content-between align-items-center mb-3">
            <span style="font-family:var(--font-ui);">
              <%= item.name_en %> × <%= item.quantity %>
            </span>
            <span class="product-price" style="font-size:0.95rem;">
              $<%= (item.price * item.quantity).toFixed(2) %>
            </span>
          </div>
        <% }) %>

        <hr class="neon-divider">

        <div class="d-flex justify-content-between">
          <span style="font-family:var(--font-display);">
            <%= lang === 'ar' ? 'الإجمالي' : 'Total' %>
          </span>
          <span class="product-price" style="font-size:1.5rem;">$<%= Number(total).toFixed(2) %></span>
        </div>
      </div>

      <div class="d-flex gap-3 mt-4">
        <a href="/orders" class="btn-neon btn flex-fill text-center">
          <span><i class="bi bi-box-seam me-2"></i>
            <%= lang === 'ar' ? 'عرض طلباتي' : 'My Orders' %>
          </span>
        </a>
        <a href="/" class="btn-neon-filled btn flex-fill text-center">
          <i class="bi bi-grid me-2"></i>
          <%= lang === 'ar' ? 'متابعة التسوق' : 'Continue Shopping' %>
        </a>
      </div>
    </div>
  </div>
</div>

