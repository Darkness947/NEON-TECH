<!-- ============================================================
     views/auth/register.ejs
     ============================================================ -->
<div class="container py-5 d-flex justify-content-center">
  <div class="neon-panel w-100" style="max-width:480px;">
    <div class="text-center mb-4">
      <div style="font-family:var(--font-display);font-size:2rem;font-weight:900;
                  background:linear-gradient(135deg,var(--neon-cyan),var(--neon-purple));
                  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">
        ⚡ NEON TECH
      </div>
      <h1 class="section-title mt-2" style="font-size:1.2rem;">
        <span class="accent"><%= lang === 'ar' ? 'إنشاء' : 'CREATE' %></span>
        <%= lang === 'ar' ? 'حساب جديد' : 'ACCOUNT' %>
      </h1>
    </div>

    <form action="/auth/register" method="POST" novalidate>

      <div class="mb-3">
        <label class="form-label" for="name">
          <i class="bi bi-person me-1"></i><%= lang === 'ar' ? 'الاسم الكامل' : 'Full Name' %>
        </label>
        <input type="text" class="form-control" id="name" name="name"
               placeholder="<%= lang === 'ar' ? 'اسمك الكامل' : 'John Doe' %>"
               autocomplete="name" required>
      </div>

      <div class="mb-3">
        <label class="form-label" for="email">
          <i class="bi bi-envelope me-1"></i><%= lang === 'ar' ? 'البريد الإلكتروني' : 'Email Address' %>
        </label>
        <input type="email" class="form-control" id="email" name="email"
               placeholder="<%= lang === 'ar' ? 'بريدك الإلكتروني' : 'you@example.com' %>"
               autocomplete="email" required>
      </div>

      <div class="mb-3">
        <label class="form-label" for="password">
          <i class="bi bi-shield-lock me-1"></i><%= lang === 'ar' ? 'كلمة المرور' : 'Password' %>
        </label>
        <input type="password" class="form-control" id="password" name="password"
               placeholder="<%= lang === 'ar' ? '8 أحرف على الأقل' : 'Min 8 characters' %>"
               minlength="8" autocomplete="new-password" required>
        <div class="mt-2" style="font-size:0.78rem;color:var(--text-muted);">
          <%= lang === 'ar'
            ? '⚡ يجب أن تكون 8 أحرف على الأقل'
            : '⚡ At least 8 characters recommended' %>
        </div>
      </div>

      <div class="mb-4">
        <label class="form-label" for="confirm_password">
          <i class="bi bi-shield-check me-1"></i><%= lang === 'ar' ? 'تأكيد كلمة المرور' : 'Confirm Password' %>
        </label>
        <input type="password" class="form-control" id="confirm_password"
               name="confirm_password"
               placeholder="<%= lang === 'ar' ? 'أعد كتابة كلمة المرور' : 'Re-enter password' %>"
               autocomplete="new-password" required>
      </div>

      <button type="submit" class="btn-neon-filled btn w-100 py-2 mb-3">
        <i class="bi bi-person-plus me-2"></i>
        <%= lang === 'ar' ? 'إنشاء حساب' : 'Create Account' %>
      </button>

      <p class="text-center" style="color:var(--text-muted);font-size:0.9rem;">
        <%= lang === 'ar' ? 'لديك حساب بالفعل؟' : 'Already have an account?' %>
        <a href="/auth/login" style="color:var(--neon-cyan);text-decoration:none;">
          <%= lang === 'ar' ? 'تسجيل الدخول' : 'Login' %>
        </a>
      </p>

    </form>
  </div>
</div>

