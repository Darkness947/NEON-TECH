<!-- ============================================================
     views/wishlist.ejs – Wishlist Page
     ============================================================ -->
<div class="container py-5">
  <h1 class="section-title mb-4">
    <span class="accent"><i class="bi bi-heart me-2"></i></span>
    <%= lang === 'ar' ? 'المفضلة' : 'My Wishlist' %>
  </h1>

  <% if (items.length === 0) { %>
    <div class="neon-panel text-center py-5">
      <i class="bi bi-heart" style="font-size:3.5rem;color:var(--text-muted);"></i>
      <p class="mt-3" style="color:var(--text-muted);">
        <%= lang === 'ar' ? 'لا توجد منتجات في مفضلتك.' : 'Your wishlist is empty.' %>
      </p>
      <a href="/" class="btn-neon btn mt-2">
        <span><%= lang === 'ar' ? 'استكشف المنتجات' : 'Explore Products' %></span>
      </a>
    </div>
  <% } else { %>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4">
      <% items.forEach(item => { %>
        <div class="col">
          <div class="product-card card border-0 h-100">
            <a href="/products/<%= item.id %>">
              <div class="overflow-hidden" style="height:200px;">
                <img src="<%= item.image_path %>"
                     alt="<%= lang === 'ar' ? item.name_ar : item.name_en %>"
                     class="card-img-top" style="height:100%;object-fit:cover;" loading="lazy">
              </div>
            </a>
            <div class="card-body d-flex flex-column">
              <p class="product-category"><%= item.category %></p>
              <h5 class="product-title">
                <a href="/products/<%= item.id %>" style="color:inherit;text-decoration:none;">
                  <%= lang === 'ar' ? item.name_ar : item.name_en %>
                </a>
              </h5>
              <span class="product-price" style="font-size:1.3rem;">
                $<%= Number(item.price).toFixed(2) %>
              </span>

              <div class="d-flex gap-2 mt-auto pt-3">
                <form action="/cart/add" method="POST" class="flex-fill">
                  <input type="hidden" name="product_id" value="<%= item.id %>">
                  <input type="hidden" name="quantity"   value="1">
                  <button type="submit" class="btn-neon btn btn-sm w-100">
                    <span><i class="bi bi-bag-plus me-1"></i>
                      <%= lang === 'ar' ? 'أضف للسلة' : 'Add to Cart' %>
                    </span>
                  </button>
                </form>
                <form action="/wishlist/toggle" method="POST">
                  <input type="hidden" name="product_id" value="<%= item.id %>">
                  <button type="submit" class="btn btn-sm" title="Remove from wishlist"
                          style="background:none;border:1px solid var(--neon-pink);color:var(--neon-pink);
                                 border-radius:6px;padding:4px 10px;">
                    <i class="bi bi-heart-fill"></i>
                  </button>
                </form>
              </div>

            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

