<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= lang === 'ar' ? 'rtl' : 'ltr' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="NEON TECH – Premium Electronics Store. Shop the latest laptops, smartphones, gaming peripherals, and audio gear with a stunning neon-themed experience.">
  <title><%= title || 'NEON TECH' %></title>

  <!-- Bootstrap 5 -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <!-- Cairo font for Arabic -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap">
  <!-- Neon Custom CSS -->
  <link rel="stylesheet" href="/css/neon.css">
</head>
<body class="<%= lang === 'ar' ? 'rtl' : '' %>">

  <%- include('../partials/navbar') %>

  <!-- Flash Messages -->
  <div class="container mt-3" style="position:relative;z-index:1;">
    <% if (success_msg && success_msg.length) { %>
      <% success_msg.forEach(msg => { %>
        <div class="alert-neon success"><i class="bi bi-check-circle me-2"></i><%= msg %></div>
      <% }) %>
    <% } %>
    <% if (error_msg && error_msg.length) { %>
      <% error_msg.forEach(msg => { %>
        <div class="alert-neon error"><i class="bi bi-exclamation-triangle me-2"></i><%= msg %></div>
      <% }) %>
    <% } %>
  </div>

  <!-- Page Content -->
  <main style="position:relative;z-index:1;">
    <%- body %>
  </main>

  <%- include('../partials/footer') %>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Main JS -->
  <script src="/js/main.js"></script>
</body>
</html>
